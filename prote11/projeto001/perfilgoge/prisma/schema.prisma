generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(OPERATOR)
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  agencyId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  OPERATOR
}

model Lead {
  id                String   @id @default(cuid())
  name              String
  category          String
  phone             String?
  website           String?
  profileUrl        String?
  placeId           String?  @unique
  rating            Float?   
  reviewsCount      Int?     
  address           String?
  neighborhood      String?
  city              String?
  state             String?
  description       String?
  photosCount       Int?     
  hasHours          Boolean  @default(false)
  hasServices       Boolean  @default(false)
  hasProducts       Boolean  @default(false)
  score             Int?     
  stage             String   @default("novo")
  dealValue         Int?     
  diagnostic        Json?
  aiContent         Json?
  clientPortalToken String?  @unique
  clientPortalData  Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notes   LeadNote[]
  history LeadHistory[]
  files   File[]
}

model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  author    String
  text      String
  createdAt DateTime @default(now())
}

model LeadHistory {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  type      String
  description String
  timestamp DateTime @default(now())
  fromStage String?
  toStage   String?
}

model PlaceCache {
  placeId        String   @id
  name           String
  data           Json
  lastEnrichedAt DateTime @default(now())
}

model AIJob {
  id         String   @id @default(cuid())
  leadId     String?
  payload    Json
  status     String   @default("queued")
  result     Json?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AIContent {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id])
  leadId      String
  content     Json
  source      String
  generatedAt DateTime
}

model PortalToken {
  id        String   @id @default(cuid())
  leadId    String?  
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Proposal {
  id        String   @id @default(cuid())
  leadId    String
  message   String
  videoUrl  String?
  createdAt DateTime @default(now())
}

model File {
  id        String   @id @default(cuid())
  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?
  key       String   @unique
  url       String
  mimeType  String
  createdAt DateTime @default(now())
}
