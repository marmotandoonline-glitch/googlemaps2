{
  "name": "perfilpro-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "npm install --include=dev && npx prisma generate && vite build && tsc --project tsconfig.json",
    "start": "npx prisma migrate deploy --schema=prisma/schema.prisma && npx tsx src/server/index.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "autoprefixer": "^10.4.21",
    "aws-sdk": "^2.1352.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^1.67.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.29.0",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^6.14.1",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
